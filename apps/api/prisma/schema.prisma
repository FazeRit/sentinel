generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String
  password String
  role     Role   @default(USER)

  labs  Lab[]
  files File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Lab {
  id          String  @id @default(uuid())
  title       String
  description String?

  files File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@map("labs")
}

model File {
  id          String  @id @default(uuid())
  name        String
  bytes       Int
  mimetype    String
  storagePath String?

  lab   Lab?    @relation(fields: [labId], references: [id])
  labId String?

  owner   User   @relation(fields: [ownerId], references: [id])
  ownerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([labId])
  @@map("files")
}
