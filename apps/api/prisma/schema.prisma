generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lab {
  id          String  @id @default(uuid())
  title       String
  description String?

  files File[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("labs")
}

model File {
  id          String  @id @default(uuid())
  name        String
  bytes       Int
  mimetype    String
  storagePath String?

  lab   Lab?    @relation(fields: [labId], references: [id])
  labId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("files")
}
